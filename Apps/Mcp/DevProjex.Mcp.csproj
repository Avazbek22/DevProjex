<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevProjex.Mcp</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);DevProjex.Mcp/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevProjex.Tests.Unit" />
    <InternalsVisibleTo Include="DevProjex.Tests.Integration" />
    <InternalsVisibleTo Include="DevProjex.Tests.Terminal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Application.csproj" GlobalPropertiesToRemove="DevProjexGrammarRuntimeIdentifier" />
    <ProjectReference Include="..\..\Assets\Assets.csproj" GlobalPropertiesToRemove="DevProjexGrammarRuntimeIdentifier" />
    <ProjectReference Include="..\..\Infrastructure\Infrastructure.csproj">
      <AdditionalProperties Condition="'$(DevProjexGrammarRuntimeIdentifier)'!=''">DevProjexGrammarRuntimeIdentifier=$(DevProjexGrammarRuntimeIdentifier)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Kernel\Kernel.csproj" GlobalPropertiesToRemove="DevProjexGrammarRuntimeIdentifier" />
  </ItemGroup>

</Project>

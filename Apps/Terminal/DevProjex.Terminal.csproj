<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevProjex.Terminal</RootNamespace>
    <!-- Branch switches can leave ignored bin/obj output under the former nested project
         directory. Exclude that legacy root so generated sources can never be compiled twice. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);DevProjex.Terminal/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevProjex.Tests.Terminal" />
    <InternalsVisibleTo Include="DevProjex.Tests.Unit" />
    <InternalsVisibleTo Include="DevProjex.Tests.Integration" />
    <InternalsVisibleTo Include="DevProjex.Tests.Terminal.ProgressHost" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\Application\Application.csproj"
      GlobalPropertiesToRemove="DevProjexGrammarRuntimeIdentifier" />
    <ProjectReference
      Include="..\..\Assets\Assets.csproj"
      GlobalPropertiesToRemove="DevProjexGrammarRuntimeIdentifier" />
    <ProjectReference
      Include="..\..\Infrastructure\Infrastructure.csproj">
      <AdditionalProperties Condition="'$(DevProjexGrammarRuntimeIdentifier)'!=''">DevProjexGrammarRuntimeIdentifier=$(DevProjexGrammarRuntimeIdentifier)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference
      Include="..\..\Kernel\Kernel.csproj"
      GlobalPropertiesToRemove="DevProjexGrammarRuntimeIdentifier" />
  </ItemGroup>
</Project>

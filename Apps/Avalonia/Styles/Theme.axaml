<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DevProjex.Avalonia.Controls"
        xmlns:converters="using:Avalonia.Controls.Converters">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
    <!-- Base Light theme (no effects) - clean neutral white -->
    <Color x:Key="AppBackgroundColor">#FFFFFF</Color>
    <Color x:Key="AppPanelColor">#F3F3F3</Color>
    <Color x:Key="AppBorderColor">#C7C7C7</Color>
    <Color x:Key="AppAccentColor">#0078D4</Color>
    <Color x:Key="AppAccentHoverColor">#006EBF</Color>
    <Color x:Key="AppAccentPressedColor">#005CA0</Color>
    <Color x:Key="AppTextColor">#1A1A1A</Color>
    <Color x:Key="AppMutedTextColor">#5E5E5E</Color>
    <Color x:Key="TreeSelectionColor">#DCEEFF</Color>
    <Color x:Key="PreviewSelectionColor">#2D8CFF</Color>
    <Color x:Key="TreeSearchHighlightColor">#F7C76B</Color>
    <Color x:Key="TreeSearchCurrentColor">#F9A825</Color>
    <Color x:Key="MenuHoverColor">#E6E6E6</Color>
    <Color x:Key="MenuPressedColor">#D9D9D9</Color>
    <Color x:Key="ToastSurfaceColor">#F3F3F3</Color>
    <Color x:Key="TreeIslandCloseBlurTintColor">#F8FBFF</Color>
    <Color x:Key="TreeIslandCloseBlurFallbackColor">#F3F3F3</Color>
    <Color x:Key="TreeIslandCloseSurfaceColor">#EAF3F3F3</Color>
    <Color x:Key="TreeIslandCloseHoverColor">#F2E6E6E6</Color>
    <Color x:Key="TreeIslandClosePressedColor">#F2D9D9D9</Color>
    <x:Double x:Key="TreeIslandCloseBlurTintOpacity">0.32</x:Double>
    <x:Double x:Key="TreeIslandCloseBlurMaterialOpacity">0.42</x:Double>
    <x:Double x:Key="TreeIslandCloseBlurCompensationLevel">0.0</x:Double>
    <Color x:Key="PreviewSectionDividerColor">#A8ACB3</Color>

    <!-- Drop Zone Colors - Light Theme -->
    <Color x:Key="DropZoneBorderColor">#0066CC</Color>
    <Color x:Key="DropZoneInnerColor">#70F0F0F0</Color>
    <Color x:Key="DropZoneFolderBackColor">#0078D4</Color>
    <Color x:Key="DropZoneFolderFrontColor">#3DA0E3</Color>
    <Color x:Key="DropZoneArrowColor">#FFFFFF</Color>
    <Color x:Key="DropZoneKbdColor">#20000000</Color>
    <Color x:Key="SegmentSelectedHoverOverlayColor">#1A000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="MainMenuStripBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="MainMenuPopupBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="{StaticResource AppAccentPressedColor}" />
    <SolidColorBrush x:Key="PrimaryActionForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="{StaticResource AppMutedTextColor}" />
    <SolidColorBrush x:Key="TreeSelectionBrush" Color="{StaticResource TreeSelectionColor}" />
    <SolidColorBrush x:Key="TreeSelectionTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="PreviewSelectionBrush" Color="{StaticResource PreviewSelectionColor}" />
    <SolidColorBrush x:Key="PreviewSelectionTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="TreeSearchHighlightBrush" Color="{StaticResource TreeSearchHighlightColor}" />
    <SolidColorBrush x:Key="TreeSearchCurrentBrush" Color="{StaticResource TreeSearchCurrentColor}" />
    <SolidColorBrush x:Key="TreeSearchHighlightTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="MenuPopupBrush" Color="{StaticResource AppPanelColor}"/>
    <SolidColorBrush x:Key="MenuChildPopupBrush" Color="{StaticResource AppPanelColor}"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="{StaticResource MenuHoverColor}"/>
    <SolidColorBrush x:Key="MenuPressedBrush" Color="{StaticResource MenuPressedColor}"/>
    <SolidColorBrush x:Key="MenuChildHoverBrush" Color="{StaticResource MenuHoverColor}"/>
    <SolidColorBrush x:Key="MenuChildPressedBrush" Color="{StaticResource MenuPressedColor}"/>
    <SolidColorBrush x:Key="ToastSurfaceBrush" Color="{StaticResource ToastSurfaceColor}" />
    <SolidColorBrush x:Key="TreeIslandCloseSurfaceBrush" Color="{StaticResource TreeIslandCloseSurfaceColor}" />
    <SolidColorBrush x:Key="TreeIslandCloseHoverBrush" Color="{StaticResource TreeIslandCloseHoverColor}" />
    <SolidColorBrush x:Key="TreeIslandClosePressedBrush" Color="{StaticResource TreeIslandClosePressedColor}" />
    <SolidColorBrush x:Key="PreviewSectionDividerBrush" Color="{StaticResource PreviewSectionDividerColor}" />

    <!-- Drop Zone Brushes - Light Theme -->
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="{StaticResource DropZoneBorderColor}" />
    <SolidColorBrush x:Key="DropZoneInnerBrush" Color="{StaticResource DropZoneInnerColor}" />
    <SolidColorBrush x:Key="DropZoneFolderBackBrush" Color="{StaticResource DropZoneFolderBackColor}" />
    <SolidColorBrush x:Key="DropZoneFolderFrontBrush" Color="{StaticResource DropZoneFolderFrontColor}" />
    <SolidColorBrush x:Key="DropZoneArrowBrush" Color="{StaticResource DropZoneArrowColor}" />
    <SolidColorBrush x:Key="DropZoneKbdBrush" Color="{StaticResource DropZoneKbdColor}" />
    <SolidColorBrush x:Key="SegmentSelectedHoverOverlayBrush" Color="{StaticResource SegmentSelectedHoverOverlayColor}" />
    <x:Double x:Key="PreviewIconOpacity">0.6</x:Double>
  </ResourceDictionary>

  <ResourceDictionary x:Key="Dark">
    <!-- Base Dark theme (no effects) - deep dark, not gray -->
    <Color x:Key="AppBackgroundColor">#121214</Color>
    <Color x:Key="AppPanelColor">#17171A</Color>
    <Color x:Key="AppBorderColor">#2B2F36</Color>
    <Color x:Key="AppAccentColor">#2D8CFF</Color>
    <Color x:Key="AppAccentHoverColor">#257BDD</Color>
    <Color x:Key="AppAccentPressedColor">#1F6BC3</Color>
    <Color x:Key="AppTextColor">#E7E9EF</Color>
    <Color x:Key="AppMutedTextColor">#9AA3B2</Color>
    <Color x:Key="TreeSelectionColor">#254861</Color>
    <Color x:Key="PreviewSelectionColor">#2D8CFF</Color>
    <Color x:Key="TreeSearchHighlightColor">#E6A23A</Color>
    <Color x:Key="TreeSearchCurrentColor">#F39C12</Color>
    <Color x:Key="MenuHoverColor">#3A3D44</Color>
    <Color x:Key="MenuPressedColor">#4A4D54</Color>
    <Color x:Key="ToastSurfaceColor">#1B1D22</Color>
    <Color x:Key="TreeIslandCloseBlurTintColor">#000000</Color>
    <Color x:Key="TreeIslandCloseBlurFallbackColor">#17171A</Color>
    <Color x:Key="TreeIslandCloseSurfaceColor">#E617171A</Color>
    <Color x:Key="TreeIslandCloseHoverColor">#F03A3D44</Color>
    <Color x:Key="TreeIslandClosePressedColor">#F04A4D54</Color>
    <x:Double x:Key="TreeIslandCloseBlurTintOpacity">0.0</x:Double>
    <x:Double x:Key="TreeIslandCloseBlurMaterialOpacity">0.55</x:Double>
    <x:Double x:Key="TreeIslandCloseBlurCompensationLevel">0.0</x:Double>
    <Color x:Key="PreviewSectionDividerColor">#4A5566</Color>

    <!-- Drop Zone Colors - Dark Theme -->
    <Color x:Key="DropZoneBorderColor">#4DA6FF</Color>
    <Color x:Key="DropZoneInnerColor">#50181820</Color>
    <Color x:Key="DropZoneFolderBackColor">#1E6BBF</Color>
    <Color x:Key="DropZoneFolderFrontColor">#2D8CFF</Color>
    <Color x:Key="DropZoneArrowColor">#FFFFFF</Color>
    <Color x:Key="DropZoneKbdColor">#25FFFFFF</Color>
    <Color x:Key="SegmentSelectedHoverOverlayColor">#22000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="MainMenuStripBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="MainMenuPopupBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="{StaticResource AppAccentPressedColor}" />
    <SolidColorBrush x:Key="PrimaryActionForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="{StaticResource AppMutedTextColor}" />
    <SolidColorBrush x:Key="TreeSelectionBrush" Color="{StaticResource TreeSelectionColor}" />
    <SolidColorBrush x:Key="TreeSelectionTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="PreviewSelectionBrush" Color="{StaticResource PreviewSelectionColor}" />
    <SolidColorBrush x:Key="PreviewSelectionTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="TreeSearchHighlightBrush" Color="{StaticResource TreeSearchHighlightColor}" />
    <SolidColorBrush x:Key="TreeSearchCurrentBrush" Color="{StaticResource TreeSearchCurrentColor}" />
    <SolidColorBrush x:Key="TreeSearchHighlightTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="MenuPopupBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="MenuChildPopupBrush" Color="{StaticResource AppPanelColor}"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="{StaticResource MenuHoverColor}"/>
    <SolidColorBrush x:Key="MenuPressedBrush" Color="{StaticResource MenuPressedColor}"/>
    <SolidColorBrush x:Key="MenuChildHoverBrush" Color="{StaticResource MenuHoverColor}"/>
    <SolidColorBrush x:Key="MenuChildPressedBrush" Color="{StaticResource MenuPressedColor}"/>
    <SolidColorBrush x:Key="ToastSurfaceBrush" Color="{StaticResource ToastSurfaceColor}" />
    <SolidColorBrush x:Key="TreeIslandCloseSurfaceBrush" Color="{StaticResource TreeIslandCloseSurfaceColor}" />
    <SolidColorBrush x:Key="TreeIslandCloseHoverBrush" Color="{StaticResource TreeIslandCloseHoverColor}" />
    <SolidColorBrush x:Key="TreeIslandClosePressedBrush" Color="{StaticResource TreeIslandClosePressedColor}" />
    <SolidColorBrush x:Key="PreviewSectionDividerBrush" Color="{StaticResource PreviewSectionDividerColor}" />

    <!-- Drop Zone Brushes - Dark Theme -->
    <SolidColorBrush x:Key="DropZoneBorderBrush" Color="{StaticResource DropZoneBorderColor}" />
    <SolidColorBrush x:Key="DropZoneInnerBrush" Color="{StaticResource DropZoneInnerColor}" />
    <SolidColorBrush x:Key="DropZoneFolderBackBrush" Color="{StaticResource DropZoneFolderBackColor}" />
    <SolidColorBrush x:Key="DropZoneFolderFrontBrush" Color="{StaticResource DropZoneFolderFrontColor}" />
    <SolidColorBrush x:Key="DropZoneArrowBrush" Color="{StaticResource DropZoneArrowColor}" />
    <SolidColorBrush x:Key="DropZoneKbdBrush" Color="{StaticResource DropZoneKbdColor}" />
    <SolidColorBrush x:Key="SegmentSelectedHoverOverlayBrush" Color="{StaticResource SegmentSelectedHoverOverlayColor}" />
    <x:Double x:Key="PreviewIconOpacity">1.0</x:Double>
  </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Compact mode uses the Fluent CheckBox template with a scale transform. -->
            <Geometry x:Key="CheckBoxIndeterminateMarkGeometry">M3,6 L9,6</Geometry>
            <Geometry x:Key="PreviewCopyIconGeometry">M6.25,2.5 H12.25 A1.75,1.75 0 0 1 14,4.25 V10.25 A1.75,1.75 0 0 1 12.25,12 H10.5 V11 H12.25 A0.75,0.75 0 0 0 13,10.25 V4.25 A0.75,0.75 0 0 0 12.25,3.5 H6.25 A0.75,0.75 0 0 0 5.5,4.25 V6 H4.5 V4.25 A1.75,1.75 0 0 1 6.25,2.5 Z M4.25,6.5 H10.25 A1.75,1.75 0 0 1 12,8.25 V14.25 A1.75,1.75 0 0 1 10.25,16 H4.25 A1.75,1.75 0 0 1 2.5,14.25 V8.25 A1.75,1.75 0 0 1 4.25,6.5 Z M4.25,7.5 A0.75,0.75 0 0 0 3.5,8.25 V14.25 A0.75,0.75 0 0 0 4.25,15 H10.25 A0.75,0.75 0 0 0 11,14.25 V8.25 A0.75,0.75 0 0 0 10.25,7.5 Z</Geometry>
            <StreamGeometry x:Key="DevProjexTreeChevronGeometry">M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 Z</StreamGeometry>
            <ControlTheme x:Key="DevProjexTreeExpandCollapseChevronTheme"
                          TargetType="ToggleButton">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Path Name="ChevronPath"
                                  Data="{StaticResource DevProjexTreeChevronGeometry}"
                                  Fill="{DynamicResource TreeViewItemForeground}"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="50%,50%"
                                  RenderTransform="rotate(0deg)" />
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked /template/ Path#ChevronPath">
                    <Setter Property="RenderTransform" Value="rotate(90deg)" />
                </Style>
                <Style Selector="^.expansion-animation-enabled /template/ Path#ChevronPath">
                    <Setter Property="Transitions">
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform"
                                                           Duration="0:0:0.12"
                                                           Easing="CubicEaseInOut" />
                        </Transitions>
                    </Setter>
                </Style>
            </ControlTheme>
            <ControlTheme x:Key="DevProjexAnimatedTreeViewItemTheme"
                          TargetType="TreeViewItem"
                          BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <!-- Preserve Fluent's public theme contract and template-part names. Only the
                     binary ItemsPresenter visibility switch is replaced by a measured host. -->
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel>
                            <Border Name="PART_LayoutRoot"
                                    Classes="TreeViewItemLayoutRoot"
                                    Focusable="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    TemplatedControl.IsTemplateFocusTarget="True">
                                <Grid Name="PART_Header"
                                      ColumnDefinitions="Auto,*">
                                    <Grid.Margin>
                                        <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                            <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <DynamicResource ResourceKey="TreeViewItemIndent" />
                                        </MultiBinding>
                                    </Grid.Margin>
                                    <Panel Name="PART_ExpandCollapseChevronContainer"
                                           Margin="12,0,12,0">
                                        <ToggleButton Name="PART_ExpandCollapseChevron"
                                                      Theme="{StaticResource DevProjexTreeExpandCollapseChevronTheme}"
                                                      Focusable="False"
                                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                                    </Panel>
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Grid.Column="1"
                                                      Focusable="False"
                                                      Background="Transparent"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                      Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                            <controls:AnimatedTreeChildrenHost Name="PART_AnimatedChildrenHost">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </controls:AnimatedTreeChildrenHost>
                        </StackPanel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Menu.main-menu-strip">
        <Setter Property="Background" Value="{DynamicResource MainMenuStripBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Suppress focus/hover border while search/filter panel is animating.
         Target both specific and generic template borders because part names differ across themes. -->
    <Style Selector="TextBox.suppress-accent,
                     TextBox.suppress-accent:focus,
                     TextBox.suppress-accent:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBox.suppress-accent /template/ Border#PART_BorderElement,
                     TextBox.suppress-accent:focus /template/ Border#PART_BorderElement,
                     TextBox.suppress-accent:pointerover /template/ Border#PART_BorderElement,
                     TextBox.suppress-accent /template/ Border,
                     TextBox.suppress-accent:focus /template/ Border,
                     TextBox.suppress-accent:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="TreeView">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!-- Compact mode - reduce tree row height without touching selection/hover behavior. -->
    <Style Selector="Window.compact-mode TreeViewItem">
        <Setter Property="Padding" Value="0,0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Tighten compact tree rows by slightly overlapping template containers vertically. -->
    <Style Selector="Window.compact-mode TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Padding" Value="0" />
        <!-- Change margin's top and bottom value for edit vertical width on TreeView -->
        <Setter Property="Margin" Value="0,-1,0,-1" />
    </Style>

    <Style Selector="Window.compact-mode TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
        <!-- Change margin's top and bottom value for edit vertical width on TreeView -->
        <Setter Property="Margin" Value="0,-1,0,-1" />
    </Style>

    <!-- Add horizontal gap between icon and text in compact mode -->
    <Style Selector="Window.compact-mode TreeView Image">
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style Selector="Window.compact-mode TextBlock.section-title">
        <Setter Property="Margin" Value="0,8,0,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Window.compact-mode Border.panel">
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Window.compact-mode Border.checklist-border">
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Tree checkboxes: adjust these sizes to scale the checkbox square in compact mode. -->
    <Style Selector="Window.compact-mode TreeView CheckBox /template/ Border#PART_Box">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style Selector="Window.compact-mode TreeView CheckBox /template/ Border#border">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style Selector="Window.compact-mode TreeView CheckBox /template/ Border#PART_Bullet">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- Disable all hover and selection highlighting on TreeViewItem -->
    <Style Selector="TreeViewItem:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="TreeViewItem:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="TreeViewItem:selected:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="TreeViewItem:selected:focus">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="TreeViewItem:pressed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!-- Override PART_LayoutRoot border inside TreeViewItem template (Fluent theme) -->
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:selected:focus:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Also override ContentPresenter background in TreeViewItem header -->
    <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:pressed /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>


    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseInOut" />
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Override Fluent template-level background for primary buttons -->
    <Style Selector="Button.primary-action /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Button.primary-action TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Button.primary-action Path">
        <Setter Property="Fill" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Button.primary-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.01)" />
    </Style>

    <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.primary-action:pressed">
        <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentPressedBrush}" />
        <Setter Property="Opacity" Value="0.95" />
        <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>

    <Style Selector="Button.primary-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ScrollBar thumb animations -->
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- ToolTip animations -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Opacity" Value="0.98" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ToolTip.preview-blurred-tooltip">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,6" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.search-panel">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>


    <Style Selector="Border.filter-panel">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.preview-panel">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="MinHeight" Value="45" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.preview-line-numbers">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.preview-sticky-header-cap">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.preview-sticky-header">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.preview-sticky-header-text">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Opacity" Value="0.78" />
    </Style>


    <!-- Rounded controls inside search/filter panels -->
    <Style Selector="Border.search-panel TextBox, Border.filter-panel TextBox">
        <Setter Property="CornerRadius" Value="6" />
        <!-- Prevent adorner-layer bleed while panel slides in/out under clipping. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <!-- Disable brush transitions for these animated inputs to avoid residual 1px border artifacts. -->
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="Border.search-panel Button, Border.filter-panel Button">
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.menu-icon-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.menu-icon-button.toolbar-mode-icon-button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.menu-icon-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style Selector="Button.menu-icon-button:pressed">
        <Setter Property="Background" Value="{DynamicResource MenuPressedBrush}" />
    </Style>

    <Style Selector="StackPanel.settings-section">
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style Selector="Border.checklist-border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.checklist-border:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- CheckBox base transitions -->
    <Style Selector="CheckBox">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Highlight checkbox when hovering anywhere on tree row (only direct row, not parent items) -->
    <Style Selector="TreeView Grid:pointerover CheckBox /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="CheckBox.list-item">
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style Selector="Border.ignore-option-item">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Border.ignore-option-separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style Selector="CheckBox.section-all">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,6,4,-6" />
    </Style>

    <!-- Compact overrides after base checkbox styles to ensure precedence. -->
    <!-- We scale the control itself to keep Fluent visuals, rather than redefining the template. -->
    <!-- Settings list checkboxes: scale control to keep Fluent visuals. -->
    <!-- To make the checkbox larger/smaller, tweak ScaleX/ScaleY below. -->
    <!-- To change label size in compact mode, set FontSize here. -->
    <Style Selector="Window.compact-mode CheckBox.list-item">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!-- Increase MinHeight if you bump FontSize to avoid clipping. -->
        <Setter Property="MinHeight" Value="0" />
        <!-- Compact label font size for settings list items. -->
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Ensure list-item labels track the CheckBox FontSize in compact mode. -->
    <Style Selector="Window.compact-mode CheckBox.list-item TextBlock">
        <Setter Property="FontSize" Value="{ReflectionBinding $parent[CheckBox].FontSize}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Fluent CheckBox template may render string content through AccessText. -->
    <Style Selector="Window.compact-mode CheckBox.list-item AccessText">
        <Setter Property="FontSize" Value="{ReflectionBinding $parent[CheckBox].FontSize}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Keep padding between checkbox and label consistent in compact mode. -->
    <Style Selector="Window.compact-mode CheckBox.list-item /template/ ContentPresenter">
        <Setter Property="Margin" Value="4,0,0,0" />
        <!-- Fluent template can override FontSize on the presenter; force it here. -->
        <Setter Property="FontSize" Value="{ReflectionBinding $parent[CheckBox].FontSize}" />
    </Style>

    <!-- "All" checkboxes: same scale as list items, but text is compensated below. -->
    <Style Selector="Window.compact-mode CheckBox.section-all">
        <Setter Property="Margin" Value="0,4,2,-9" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        <Setter Property="RenderTransform">
            <!-- Keep checkbox visuals consistent with list items. -->
            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
        </Setter>
    </Style>

    <!-- Compensate text size for "All" checkboxes so label stays readable. -->
    <!-- If you change the checkbox scale, adjust this inverse scale accordingly. -->
    <!-- Increase these scale values to make "All" label font larger in compact mode. -->
    <Style Selector="Window.compact-mode CheckBox.section-all /template/ ContentPresenter">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        <Setter Property="RenderTransform">
            <ScaleTransform ScaleX="1.136" ScaleY="1.136" />
        </Setter>
    </Style>

    <Style Selector="ScrollViewer.checklist-scroll">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollViewer.preview-scroll">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Ibeam" />
    </Style>

    <Style Selector="ScrollViewer.preview-scroll ScrollBar">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Fluent ScrollViewer reserves the bottom-right separator cell for the horizontal scrollbar corner.
         Preview keeps horizontal scrolling for long lines, but the reserved cell visually cuts the vertical rail short. -->
    <Style Selector="ScrollViewer.preview-scroll /template/ ScrollBar#PART_VerticalScrollBar">
        <Setter Property="Grid.RowSpan" Value="2" />
    </Style>

    <Style Selector="ScrollViewer.preview-scroll /template/ Panel#PART_ScrollBarsSeparator">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ScrollViewer.preview-scroll RepeatButton">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="ScrollViewer.preview-scroll Thumb">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Fix font inheritance for TextBlock in TreeView -->
    <Style Selector="TreeView TextBlock">
        <Setter Property="FontFamily" Value="{ReflectionBinding $parent[TreeView].FontFamily}" />
        <Setter Property="FontSize" Value="{ReflectionBinding $parent[TreeView].FontSize}" />
    </Style>

    <!-- Theme Popover Styles (Win11 Settings-like card) -->
    <Style Selector="Border.theme-popover">
        <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="50%,0%" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBlock.popover-section-title">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Popup Separator -->
    <Style Selector="Popup Separator">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- Compact Slider in popover -->
    <Style Selector="Border.theme-popover Slider">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="16" />
    </Style>

    <!-- ProgressBar styling -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Slider styling -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Slider /template/ Thumb:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.1)" />
    </Style>

    <!-- Menu and MenuItem styling -->
    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style Selector="MenuItem.recent-folder-unavailable">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" />
    </Style>

    <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuPressedBrush}" />
    </Style>

    <!-- Hard-disable TreeViewItem hover/selection background in Fluent template -->
    <Style Selector="TreeViewItem:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>


    <Style Selector="TreeViewItem:selected /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>


    <Style Selector="TreeViewItem:pressed /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>


    <Style Selector="TreeViewItem:selected:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ContextMenu styling -->
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="WindowManagerAddShadowHint" Value="False" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="RenderTransformOrigin" Value="50%,0%" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="RenderTransformOrigin" Value="50%,0%" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="MenuItem /template/ Popup">
        <Setter Property="WindowManagerAddShadowHint" Value="False" />
    </Style>

    <!-- Menu popup backgrounds -->
    <Style Selector="MenuItem /template/ Popup > Border">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="4" />
    </Style>


    <!-- Submenu popup backgrounds -->
    <Style Selector="MenuItem MenuItem /template/ Popup > Border">
        <Setter Property="Background" Value="{DynamicResource MenuChildPopupBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- The main menu uses one material at every popup depth. -->
    <Style Selector="Menu.main-menu-strip MenuItem /template/ Popup > Border">
        <Setter Property="Background" Value="{DynamicResource MainMenuPopupBrush}" />
    </Style>

    <Style Selector="MenuItem.git-branch-menu-scrollable /template/ Popup > Border">
        <!-- 15 branch rows: (32px row + 2px vertical margin) * 15, plus popup padding. -->
        <Setter Property="MaxHeight" Value="518" />
    </Style>

    <Style Selector="MenuItem.git-branch-menu-scrollable /template/ Popup ScrollViewer">
        <!-- Keep real MenuItem containers for correct hover/selection while the popup scrolls. -->
        <Setter Property="MaxHeight" Value="510" />
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    </Style>

    <Style Selector="MenuItem.git-branch-menu-scrollable /template/ Popup ScrollBar:vertical">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="MinWidth" Value="12" />
    </Style>

    <Style Selector="MenuItem.git-branch-menu-scrollable /template/ Popup ScrollBar:vertical /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="MenuItem.git-branch-menu-scrollable /template/ Popup ScrollBar:vertical /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="Grid.git-branch-external-scrollbar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.git-branch-scroll-indicator-track">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style Selector="Border.git-branch-scroll-indicator-thumb">
        <Setter Property="Background" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="Grid.git-branch-external-scrollbar:pointerover Border.git-branch-scroll-indicator-thumb">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Submenu item backgrounds -->
    <Style Selector="MenuItem MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="2,1" />
    </Style>

    <Style Selector="MenuItem MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="MenuItem MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuChildHoverBrush}" />
    </Style>

    <Style Selector="MenuItem MenuItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuChildPressedBrush}" />
    </Style>

    <!-- ============================================== -->
    <!-- Segmented Control Styles                       -->
    <!-- ============================================== -->

    <!-- Container: pill-shaped border around the entire segmented control -->
    <Style Selector="Border.segmented-control">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Sliding thumb indicator behind the selected segment -->
    <Style Selector="Border.segment-thumb">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Thumb positions for the top tree-format switcher. -->
    <Style Selector="Border.segment-thumb.segment-thumb-json">
        <Setter Property="RenderTransform" Value="translate(48px, 0px)" />
    </Style>

    <Style Selector="Border.segment-thumb.segment-thumb-xml">
        <Setter Property="RenderTransform" Value="translate(96px, 0px)" />
    </Style>

    <Style Selector="Border.segment-thumb.segment-thumb-md">
        <Setter Property="RenderTransform" Value="translate(144px, 0px)" />
    </Style>

    <!-- Kept for older callers that still use the previous two-segment class name. -->
    <Style Selector="Border.segment-thumb.segment-thumb-right">
        <Setter Property="RenderTransform" Value="translate(48px, 0px)" />
    </Style>

    <!-- Text button for segment (transparent, overlays the thumb) -->
    <Style Selector="Button.segment-text-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="Padding" Value="0,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="48" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Segment text button: hover (unselected) -->
    <Style Selector="Button.segment-text-button:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!-- Segment text button: pressed -->
    <Style Selector="Button.segment-text-button:pressed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Segment text button: selected state -->
    <Style Selector="Button.segment-text-button.segment-selected">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Button.segment-text-button.segment-selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Button.segment-text-button.segment-selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <!-- Segment text button: selected + hover -->
    <Style Selector="Button.segment-text-button.segment-selected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource SegmentSelectedHoverOverlayBrush}" />
    </Style>

    <Style Selector="Button.segment-text-button.segment-selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SegmentSelectedHoverOverlayBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Button.segment-text-button.segment-selected:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-suspended Button.segment-text-button:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-suspended Button.segment-text-button.segment-selected:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-suspended Button.segment-text-button.segment-selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-suspended Button.preview-close-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-suspended Button.preview-copy-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <!-- Segment control: disabled -->
    <Style Selector="Border.segmented-control:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Border.format-segmented-control Grid.format-segment-divider-layer">
        <Setter Property="Width" Value="192" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.format-segmented-control Border.format-segment-divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="CornerRadius" Value="0.5" />
        <Setter Property="Opacity" Value="0.58" />
    </Style>

    <Style Selector="Border.preview-segmented-control">
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="544" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.preview-segmented-control Grid.preview-segment-divider-layer">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.preview-segmented-control Border.preview-segment-divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="CornerRadius" Value="0.5" />
        <Setter Property="Opacity" Value="0.58" />
    </Style>

    <Style Selector="Button.preview-segment-button TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.preview-segment-thumb">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.preview-segment-button">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.preview-close-button">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.preview-close-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style Selector="Button.preview-copy-button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.preview-copy-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style Selector="Border.preview-sticky-copy-host">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BoxShadow" Value="0 1 4 0 #22000000" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.preview-sticky-copy-button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.preview-sticky-copy-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style Selector="Button.tree-island-close-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.tree-island-close-button:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.tree-island-close-button:pressed">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The visible surface is inside the Button content, so hover/pressed states must target it directly. -->
    <Style Selector="Button.tree-island-close-button Border.tree-island-close-surface">
        <Setter Property="Background" Value="{DynamicResource TreeIslandCloseSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.tree-island-close-button:pointerover Border.tree-island-close-surface">
        <Setter Property="Background" Value="{DynamicResource TreeIslandCloseHoverBrush}" />
    </Style>

    <Style Selector="Button.tree-island-close-button:pressed Border.tree-island-close-surface">
        <Setter Property="Background" Value="{DynamicResource TreeIslandClosePressedBrush}" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-compact Grid#PreviewBarLayoutGrid">
        <Setter Property="Margin" Value="10,5" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-compact Border.preview-segmented-control">
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-compact Button.preview-segment-button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,4" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-narrow Grid#PreviewBarLayoutGrid">
        <Setter Property="Margin" Value="6,5" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-narrow Border.preview-segmented-control">
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-narrow Button.preview-segment-button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,3" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-narrow Button.preview-close-button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <Style Selector="Border.preview-panel.preview-toolbar-narrow Button.preview-copy-button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

    <Style Selector="Path.preview-icon">
        <Setter Property="Opacity" Value="{DynamicResource PreviewIconOpacity}" />
    </Style>

</Styles>

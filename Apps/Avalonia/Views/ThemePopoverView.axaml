<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevProjex.Avalonia.ViewModels"
             x:Class="DevProjex.Avalonia.Views.ThemePopoverView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">
  <Border Classes="theme-popover" Padding="14" MinWidth="300">
    <StackPanel Spacing="12">
      <!-- Theme selection row -->
      <StackPanel Spacing="4">
        <TextBlock Classes="popover-section-title" Text="{Binding ThemeModeLabel}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <CheckBox x:Name="SystemThemeCheckBox"
                    Content="{Binding ThemeSystemLabel}"
                    IsChecked="{Binding IsSystemThemeSelected, Mode=OneWay}"
                    Click="OnSetSystemThemeCheckbox" />
          <CheckBox x:Name="LightThemeCheckBox"
                    Content="{Binding ThemeLightLabel}"
                    IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"
                    Click="OnSetLightThemeCheckbox" />
          <CheckBox x:Name="DarkThemeCheckBox"
                    Content="{Binding ThemeDarkLabel}"
                    IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                    Click="OnSetDarkThemeCheckbox" />
        </StackPanel>
      </StackPanel>

      <!-- Effects mode row -->
      <StackPanel Spacing="4">
        <TextBlock Classes="popover-section-title" Text="{Binding ThemeEffectsLabel}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <CheckBox x:Name="TransparentEffectCheckBox"
                    Content="{Binding ThemeTransparentLabel}"
                    IsChecked="{Binding IsTransparentEnabled, Mode=OneWay}"
                    Click="OnSetTransparentMode" />
          <CheckBox x:Name="BlurEffectCheckBox"
                    Content="{Binding ThemeBlurLabel}"
                    IsVisible="{Binding IsAcrylicAvailable}"
                    IsChecked="{Binding IsAcrylicEnabled, Mode=OneWay}"
                    Click="OnSetAcrylicMode" />
          <CheckBox x:Name="MicaEffectCheckBox"
                    Content="{Binding ThemeMicaLabel}"
                    IsVisible="{Binding IsMicaAvailable}"
                    IsChecked="{Binding IsMicaEnabled, Mode=OneWay}"
                    Click="OnSetMicaMode" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding ShowBackgroundTransparencySlider}">
        <Separator Margin="0,2" />
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding ThemeBackgroundTransparency}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,-14"/>
          <Slider x:Name="BackgroundTransparencySlider"
                  Minimum="0"
                  Maximum="100"
                  SmallChange="1"
                  LargeChange="10"
                  AutomationProperties.Name="{Binding ThemeBackgroundTransparency}"
                  Value="{Binding BackgroundTransparency}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="6">
        <Separator Margin="0,2" IsVisible="{Binding !ShowBackgroundTransparencySlider}" />
        <StackPanel Spacing="2" IsVisible="{Binding HasAnyEffect}">
          <TextBlock Text="{Binding ThemePanelContrast}" FontSize="12" Margin="0,4,0,-14"/>
          <Slider x:Name="PanelContrastSlider"
                  Minimum="0"
                  Maximum="100"
                  SmallChange="1"
                  LargeChange="10"
                  AutomationProperties.Name="{Binding ThemePanelContrast}"
                  Value="{Binding PanelContrast}" />
        </StackPanel>
        <StackPanel Spacing="2" IsVisible="{Binding HasAnyEffect}">
          <TextBlock Text="{Binding ThemeMenuTransparency}" FontSize="12" Margin="0,4,0,-14"/>
          <Slider x:Name="MenuTransparencySlider"
                  Minimum="0"
                  Maximum="100"
                  SmallChange="1"
                  LargeChange="10"
                  AutomationProperties.Name="{Binding ThemeMenuTransparency}"
                  Value="{Binding MenuTransparency}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding ThemeBorderVisibility}" FontSize="12" Margin="0,4,0,-14"/>
          <Slider x:Name="BorderVisibilitySlider"
                  Minimum="0"
                  Maximum="100"
                  SmallChange="1"
                  LargeChange="10"
                  AutomationProperties.Name="{Binding ThemeBorderVisibility}"
                  Value="{Binding BorderVisibility}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

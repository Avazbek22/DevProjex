<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevProjex.Avalonia.ViewModels"
        x:Class="DevProjex.Avalonia.Views.GitCloneWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="{Binding GitCloneTitle}"
        Width="420"
        MinWidth="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur, Blur, None"
        Icon="avares://DevProjex/AppIcon/app.ico">
  <Window.Styles>
    <Style Selector="Border.clone-window-card">
      <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BoxShadow" Value="0 6 20 0 #50000000" />
    </Style>

    <Style Selector="StackPanel.clone-progress-surface">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style Selector="ComboBox.recent-repositories-combo">
      <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ComboBox.recent-repositories-combo /template/ Border#PART_BorderElement,
                     ComboBox.recent-repositories-combo /template/ Border">
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="ComboBox.recent-repositories-combo /template/ Popup#PART_Popup">
      <Setter Property="ShouldUseOverlayLayer" Value="False" />
      <Setter Property="WindowManagerAddShadowHint" Value="False" />
    </Style>

    <Style Selector="ComboBox.recent-repositories-combo /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="ComboBox.recent-repositories-combo ComboBoxItem">
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ComboBox.recent-repositories-combo ComboBoxItem:pointerover /template/ Border#PART_BorderElement,
                     ComboBox.recent-repositories-combo ComboBoxItem:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ComboBox.recent-repositories-combo ComboBoxItem:selected /template/ Border#PART_BorderElement,
                     ComboBox.recent-repositories-combo ComboBoxItem:selected /template/ Border">
      <Setter Property="Background" Value="{DynamicResource MenuPressedBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Window.Styles>

  <Border Name="CloneWindowCard"
          Classes="clone-window-card"
          Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <!-- Description (visible when not in progress) -->
      <TextBlock Grid.Row="0"
                 Text="{Binding GitCloneDescription}"
                 Margin="0,0,0,8"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Opacity="0.8"
                 IsVisible="{Binding !GitCloneInProgress}" />

      <!-- URL Input (visible when not in progress) -->
      <TextBox Grid.Row="1"
               Name="UrlTextBox"
               Text="{Binding GitCloneUrl, Mode=TwoWay}"
               PlaceholderText="{Binding GitCloneUrlPlaceholder}"
               Margin="0,0,0,16"
               IsVisible="{Binding !GitCloneInProgress}"
               TextChanged="OnUrlTextChanged" />

      <!-- Recent repositories (visible when not in progress) -->
      <Border Name="RecentRepositoriesContainer"
              Grid.Row="2"
              Margin="0,0,0,12"
              IsVisible="{Binding GitCloneRecentRepositoriesVisible}">
        <StackPanel>
          <TextBlock Name="RecentRepositoriesLabelText"
                     Text="{Binding GitCloneRecentRepositoriesLabel}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="2,0,0,5" />
          <ComboBox Name="RecentRepositoriesComboBox"
                  Classes="recent-repositories-combo"
                  ItemsSource="{Binding RecentRepositories}"
                  IsEnabled="{Binding HasRecentRepositories}"
                  PlaceholderText="{Binding GitCloneRecentRepositoriesLabel}"
                  AutomationProperties.Name="{Binding GitCloneRecentRepositoriesLabel}"
                  SelectionChanged="OnRecentRepositorySelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectEntryViewModel">
              <StackPanel Spacing="0">
                <TextBlock Text="{Binding DisplayText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ToolTipText}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Border>

      <StackPanel Name="LocalCacheContainer"
                  Grid.Row="3"
                  Margin="0,0,0,14"
                  IsVisible="{Binding GitCloneLocalCacheVisible}">
        <TextBlock Name="LocalCacheLabelText"
                   Text="{Binding GitCloneLocalCacheLabel}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="2,0,0,5" />
        <ComboBox Name="LocalCacheComboBox"
                  Classes="recent-repositories-combo"
                  ItemsSource="{Binding CachedRepositories}"
                  SelectedItem="{Binding SelectedGitCloneCacheEntry, Mode=TwoWay}"
                  IsEnabled="{Binding CanUseGitCloneLocalCache}"
                  PlaceholderText="{Binding GitCloneLocalCacheLabel}"
                  AutomationProperties.Name="{Binding GitCloneLocalCacheLabel}"
                  MaxDropDownHeight="320"
                  SelectionChanged="OnLocalCacheSelectionChanged">
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="vm:RepositoryCacheEntryViewModel">
              <StackPanel Spacing="0"
                          Tag="{Binding}">
                <ToolTip.Tip>
                  <ToolTip Content="{Binding ToolTipText}" />
                </ToolTip.Tip>
                <TextBlock Text="{Binding DisplayName}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DetailsText}"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RepositoryCacheEntryViewModel">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <ToolTip.Tip>
                  <ToolTip Content="{Binding ToolTipText}" />
                </ToolTip.Tip>
                <StackPanel Grid.Column="0"
                            Spacing="0">
                  <TextBlock Text="{Binding DisplayName}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DetailsText}"
                             FontSize="11"
                             Opacity="0.6"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        Classes="cache-delete-tooltip-host"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding DeleteToolTip}"
                        Tag="{Binding}">
                  <Button Name="DeleteLocalCacheEntryButton"
                          Classes="menu-icon-button"
                          Width="24"
                          Height="24"
                          MinWidth="24"
                          MinHeight="24"
                          Padding="2"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="{Binding RemoveText}"
                          IsEnabled="{Binding CanDelete}"
                          Tag="{Binding}"
                          Click="OnDeleteLocalCacheEntry">
                    <Viewbox Width="20"
                             Height="20"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform">
                      <Canvas Width="24"
                              Height="24">
                        <Path Data="M8,3 H16 M5,6 H19 M7,6 V20 H17 V6 M10,10 V17 M14,10 V17"
                              Stroke="{DynamicResource AppTextBrush}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                      </Canvas>
                    </Viewbox>
                  </Button>
                </Border>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Progress section (visible when in progress) -->
      <StackPanel Grid.Row="1"
                  Classes="clone-progress-surface"
                  IsVisible="{Binding GitCloneInProgress}">
        <TextBlock Text="{Binding GitCloneStatus}"
                   FontSize="13"
                   Margin="0,0,0,8" />
        <ProgressBar Name="CloneProgressBar"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding GitCloneProgressValue}"
                     IsIndeterminate="{Binding GitCloneProgressIsIndeterminate}"
                     Height="4" />
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Name="StartCloneButton"
                Content="{Binding DialogOK}"
                Classes="primary-action"
                MinWidth="80"
                HorizontalContentAlignment="Center"
                Click="OnStartClone"
                IsDefault="True"
                IsVisible="{Binding !GitCloneInProgress}"
                IsEnabled="{Binding CanStartGitClone}" />
        <Button Name="CancelCloneButton"
                Content="{Binding DialogCancel}"
                IsCancel="True"
                Click="OnCancel" />
      </StackPanel>
    </Grid>
  </Border>
</Window>

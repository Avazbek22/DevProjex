<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <DevProjexVersion Condition="'$(DevProjexVersion)'==''">5.1</DevProjexVersion>
    <DevProjexAssemblyVersion Condition="'$(DevProjexAssemblyVersion)'==''">5.1.0.0</DevProjexAssemblyVersion>
    <DevProjexFileVersion Condition="'$(DevProjexFileVersion)'==''">$(DevProjexAssemblyVersion)</DevProjexFileVersion>
    <DevProjexInformationalVersion Condition="'$(DevProjexInformationalVersion)'==''">$(DevProjexVersion)</DevProjexInformationalVersion>
    <DevProjexStorePackageVersion Condition="'$(DevProjexStorePackageVersion)'==''">5.1.0.0</DevProjexStorePackageVersion>
    <Version>$(DevProjexVersion)</Version>
    <AssemblyVersion>$(DevProjexAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(DevProjexFileVersion)</FileVersion>
    <InformationalVersion>$(DevProjexInformationalVersion)</InformationalVersion>
    <Copyright>© 2025–present Avazbek Olimov</Copyright>
    <!-- Keep user-facing version output stable; CI/build commit hashes belong in artifacts, not terminal output. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TestTfmsInParallel>false</TestTfmsInParallel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ReleaseStore'">
    <DefineConstants>$(DefineConstants);DEVPROJEX_STORE</DefineConstants>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- A packaged app loads grammars only from signed package content: under package identity
         CodeCompressionFactory refuses runtime-materialized libraries, so embedded delivery leaves
         every Store user without compression. Content delivery is mandatory here. -->
    <DevProjexGrammarDelivery>Content</DevProjexGrammarDelivery>
  </PropertyGroup>
</Project>

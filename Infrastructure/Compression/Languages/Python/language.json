{
  "id": "python",
  "displayName": "Python",
  "extensions": [
    ".py",
    ".pyi"
  ],
  "library": "tree-sitter-python",
  "export": "tree_sitter_python",
  "queryVersion": 4,
  "blockPlaceholder": "...",
  "blockBodyStyle": "indented-statement",
  "preserveLeadingDocstring": true,
  "containerNodeTypes": [
    "module",
    "class_definition"
  ],
  "executableOwnerKinds": [
    "function_definition"
  ]
}

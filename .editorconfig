# Code style, measured from this repository rather than taken from a template.
#
# Every value below was counted over the 1,556 tracked C# files before it was written down, and the
# count is quoted beside it. Where the tree is not uniform, the value follows the majority and the
# minority is named, so that a later reader can tell a deliberate choice from an accident.
#
# Nothing here reformats anything on its own. `Scripts/ci/Test-Indentation.ps1` compares each
# changed file against its own state at the base commit and fails only when a file that matched
# these rules stops matching them; 736 files do not match them today and are left alone. Bringing
# those into line rewrites authorship across the tree and collides with every open branch, so that
# is a separate decision, taken separately.

root = true

[*.cs]

# Indentation: 342,276 tab-led lines against 81,866 space-led, so 80.7% of indented lines and
# 1,167 of 1,556 files. Apps/Terminal and Apps/Mcp are tabs without exception.
indent_style = tab

# Width 4 is pinned by the 105 files that carry both: N tabs and 4N spaces sit on adjacent lines at
# the same nesting depth.
indent_size = 4
tab_width = 4

# Safe as measured: no tracked file lacks a final newline.
insert_final_newline = true

# Three files carry trailing whitespace, and all three already differ from these rules for other
# reasons, so enabling this flags nothing that was not already flagged. It was off here until the
# count was checked: an earlier survey reported 421 files, having counted the carriage return of a
# CRLF working tree as trailing whitespace.
trim_trailing_whitespace = true

# `end_of_line` is deliberately absent. The index stores LF and the working tree is CRLF through
# `core.autocrlf`, with no `* text=auto` in .gitattributes, so pinning either value would declare
# every checkout on the other platform wrong. The gate formats the base and the head on the same
# runner, which makes the platform default cancel out.

# Namespaces are file-scoped in 1,544 declarations against 2, and both exceptions are sample source
# inside a test fixture string literal.
csharp_style_namespace_declarations = file_scoped:suggestion

# Braces open on their own line in 38,171 places against 288. `else`, `catch` and `finally` begin
# their own line in 767, 1,356 and 1,027 places.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

# A single-statement `if` body is left unbraced in 8,269 of 11,678 places, 70.8%. Requiring braces
# would flag every one of them, so this records what the code does.
csharp_prefer_braces = false:silent

# `var` in 49,673 declarations against 1,196 explicit, and the explicit residue is almost entirely
# places where `var` is not legal: `var x = new ...` appears 12,305 times, `Type x = new ...` ten.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Accessibility is explicit on every type declaration in compiled code. The 45 lines that declare a
# type without a modifier are all sample source inside test fixture string literals, one of them
# Python.
dotnet_style_require_accessibility_modifiers = always:suggestion

# `this.` appears 109 times across 22 of 1,556 files, against 19,111 references to an
# underscore-prefixed field, and every use is constructor disambiguation.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# All 2,222 using directives sit outside the namespace, System first in the large majority of files
# that have both, and with no blank line between groups.
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# 99.6% of lines are under 120 columns: 1,856 of 435,824 exceed it. Advisory — the formatter does
# not rewrap, and the longest lines in the tree are single string literals that cannot be broken.
max_line_length = 120

[Apps/Avalonia/**.cs]

# The one area where the majority runs the other way: 79 space-indented files against 27 tabbed,
# with 46 carrying both, and 28.9% of its indented lines are tab-led against 80.7% across the tree.
# Recorded here so the gate judges those files by what they are, rather than dragging them toward
# the repository default.
indent_style = space
indent_size = 4
tab_width = 4

[*.{md,yml,yaml,json,ps1,psm1,sh}]
indent_style = unset
indent_size = unset
